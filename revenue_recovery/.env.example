# RevPlug Backend Configuration Template
# Copy this file to .env before starting the server

# Persistence Mode: "inmemory" (default for demo/tests) or "postgres"
PERSISTENCE_MODE=inmemory

# Execution Mode: "simulation" (default for unit tests/offline) or "razorpay_test" (live judge demo)
RECOVERY_EXECUTION_MODE=simulation
RECOVERY_SIMULATION=true

# AI Provider Architecture Configuration
AI_ENABLED=true
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
AI_HIGH_CONFIDENCE_THRESHOLD=0.80
AI_LOW_CONFIDENCE_THRESHOLD=0.50

# Server Settings
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Razorpay Test Mode Integration Configuration
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
RAZORPAY_ENV=test

# Database Connection (Required only when PERSISTENCE_MODE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=revenue_recovery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
