# RecoverOS Backend Configuration Template
# Copy this file to .env before starting the server

# Persistence Mode: "inmemory" (default for demo/tests) or "postgres"
PERSISTENCE_MODE=inmemory

# Simulation Mode: "true" (default for hackathon demo) or "false"
RECOVERY_SIMULATION=true

# Server Settings
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Razorpay Provider Integration (Optional - simulated in demo mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key

# Database Connection (Required only when PERSISTENCE_MODE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=revenue_recovery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
